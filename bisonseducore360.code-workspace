{
  "folders": [
    {
      "name": "Frontend — bisonseducore360",
      "path": "../bisonseducore360"
    },
    {
      "name": "Backend — bisonseducore360_backend",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.next": true,
      "**/out": true,
      "**/.kilo": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/.next": true,
      "**/out": true,
      "**/.kilo": true,
      "**/node_modules": true,
      "**/*.tsbuildinfo": true
    },
    "files.watcherExclude": {
      "**/.next/**": true,
      "**/node_modules/**": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  }
}
