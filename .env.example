# ── Server ───────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins (the Next.js frontend).
# CORS runs with credentials:true so the httpOnly session cookie can be sent.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Session cookie
COOKIE_NAME=bisons_session
# Set to your base domain in production so app. + api. share the cookie.
# Leave EMPTY for localhost development.
COOKIE_DOMAIN=
# true in production (HTTPS only). Keep false on http://localhost.
COOKIE_SECURE=false
# lax | strict | none   (use "none" only together with COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# ── Subscription ─────────────────────────────────────────────
TRIAL_DAYS=5
# Days left at which the UI starts warning the school.
SUBSCRIPTION_WARNING_DAYS=3

# ── Database (Neon Postgres) ─────────────────────────────────
# Pooled connection string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct / unpooled connection string (NO "-pooler") — required by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
#
# Local Postgres alternative (development only):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/bisonseducore360?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/bisonseducore360?schema=public"

# ── Email (NOT part of the auth scope yet) ───────────────────
# Left here so the module has a home when verification/OTP lands.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@bisonstechs.com

# ── Cloudinary (uploads — not part of the auth scope yet) ────
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
