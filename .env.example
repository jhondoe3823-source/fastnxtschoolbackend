# Copy to .env and fill in values.

# ── Email (Resend) ───────────────────────────────────────────
EMAIL_ENABLED=true
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=BisonsEduCore360 <no-reply@bisonstechs.com>
EMAIL_REPLY_TO=support@bisonstechs.com

# Platform branding (welcome / system emails)
BRAND_NAME=BisonsTechs
PRODUCT_NAME=BisonsEduCore360
BRAND_LOGO_URL=https://bisonstechs.com/logo.png
BRAND_WEBSITE=https://bisonstechs.com
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@bisonstechs.com

# School-branded emails use each school's logoUrl from Institute Profile.
