# Copy to .env and fill in values.

# ── CORS (school app + admin console origins) ────────────────
# Comma-separated. Include every Vercel/local frontend that calls this API.
# Example:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bisonseducore360.vercel.app,https://bisonseducore360-admin.vercel.app,https://bisonseducore360-admin*
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bisonseducore360.vercel.app,https://bisonseducore360-admin.vercel.app,https://bisonseducore360-admin*

# ── Email (Resend) ───────────────────────────────────────────
EMAIL_ENABLED=true
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=
EMAIL_REPLY_TO=

# Platform branding (welcome / system emails)
BRAND_NAME=FastNxt
PRODUCT_NAME=FastNxt
BRAND_LOGO_URL=
BRAND_WEBSITE=
APP_URL=http://localhost:3000
SUPPORT_EMAIL=

# Platform admin console — only listed emails can sign in
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_COOKIE_NAME=bisons_platform_session

# School-branded emails use each school's logoUrl from Institute Profile.
