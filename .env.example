# Copy to .env and fill in values.

# ── CORS (school app + admin console origins) ────────────────
# Comma-separated. Include every Vercel/local frontend that calls this API.
# Example:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bisonseducore360.vercel.app,https://bisonseducore360-admin.vercel.app,https://bisonseducore360-admin*
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bisonseducore360.vercel.app,https://bisonseducore360-admin.vercel.app,https://bisonseducore360-admin*

# ── Email (Resend) ───────────────────────────────────────────
EMAIL_ENABLED=true
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=BisonsEduCore360 <no-reply@bisonstechs.com>
EMAIL_REPLY_TO=support@bisonstechs.com

# Platform branding (welcome / system emails)
BRAND_NAME=BisonsTechs
PRODUCT_NAME=BisonsEduCore360
BRAND_LOGO_URL=https://bisonstechs.com/logo.png
BRAND_WEBSITE=https://bisonstechs.com
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@bisonstechs.com

# Platform admin console (bisonseducore_360_admin) — only listed emails can sign in
PLATFORM_ADMIN_EMAILS=adminbisonseducore360@gmail.com
PLATFORM_ADMIN_PASSWORD=BisonsAdmin@360
PLATFORM_COOKIE_NAME=bisons_platform_session

# School-branded emails use each school's logoUrl from Institute Profile.
