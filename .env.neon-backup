# frequently fails with P1001 when it is present.
DATABASE_URL="postgresql://neondb_owner:npg_BUhr7jVeqYu3@ep-rough-glade-b36bqeie-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct / unpooled connection string (NO "-pooler") — REQUIRED by Prisma migrations.
DIRECT_URL="postgresql://neondb_owner:npg_BUhr7jVeqYu3@ep-rough-glade-b36bqeie.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
