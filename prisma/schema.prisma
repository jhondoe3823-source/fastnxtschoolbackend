// FastNxt — Prisma schema
// Scope: authentication + school registration + subscription foundation.
//
// NOTE ON EMAIL UNIQUENESS
// Postgres `@unique` is case-sensitive. Every email is normalised to lowercase
// in the service layer before it is written, so `Admin@School.com` and
// `admin@school.com` cannot both exist. Do not rely on the DB alone for this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: pooled URL for runtime, unpooled/direct URL for migrations.
  // Locally both may point at the same database.
  directUrl = env("DIRECT_URL")
}

/// Billing plan the school bought. TRIAL is the 5-day free window.
enum SubscriptionPlan {
  TRIAL
  MONTHLY
  YEARLY
}

/// TRIAL = inside the free window, ACTIVE = paid and running,
/// EXPIRED = past `expiresAt` (derived and persisted lazily on read).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

/// Branch status - Active branches can have students/classes, Inactive are read-only.
enum BranchStatus {
  ACTIVE
  INACTIVE
}

/// A registered institution.
///
/// `name` … `city` are captured at registration. Everything below them is the
/// optional half of the profile, filled in later from
/// Admin Panel → Settings → Institute Profile. They are nullable on purpose:
/// a school is usable the moment it registers, and the profile fills in over
/// time (no empty-string sentinels to distinguish "unset" from "cleared").
model School {
  id        String @id @default(cuid())
  name      String
  ownerName String
  email     String @unique
  phone     String
  country   String
  city      String

  /// Abbreviated name used on letters, ID cards and the shell brand.
  shortName       String?
  /// Postal address, shown on invoices, letters and certificates.
  address         String?
  /// Public website, printed in document footers.
  website         String?
  /// Tagline shown under the school name in previews.
  motto           String?
  /// Head of the institution, printed as the signatory on letters.
  principal       String?
  /// Active academic session, e.g. "2025-2026".
  academicSession String?
  /// Government/institute registration number.
  instituteNo     String?
  /// Logo URL (Cloudinary once uploads are enabled; a plain URL works today).
  logoUrl         String?
  /// Editable fee voucher / invoice layout (titles, bank details, signatures…).
  feeVoucherTemplate Json?
  /// Editable admission letter layout (title, body, signatures…).
  admissionLetterTemplate Json?
  /// Editable job / appointment letter layout.
  jobLetterTemplate Json?
  /// Per-school admission application form variant + labels (standard | apl-legal-it).
  admissionFormConfig Json?
  /// Platform admin can deactivate a whole school — users cannot sign in.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  subscriptions      Subscription[]
  branches           Branch[]
  rolePermissions    RolePermission[]
  tickets            Ticket[]
  employees          Employee[]
  jobLetters         JobLetter[]
  classes            Class[]
  courses            Course[]
  subjects           Subject[]
  subjectAssignments SubjectAssignment[]
  students           Student[]
  admissionLetters   AdmissionLetter[]
  families           Family[]
  admissionEnquiries AdmissionEnquiry[]
  visitors           Visitor[]
  notices            Notice[]
  events             Event[]
  meetings           Meeting[]
  googleIntegrations GoogleIntegration[]
  onlineClasses      OnlineClass[]
  vehicles           Vehicle[]
  transportRoutes    TransportRoute[]
  hostelRooms        HostelRoom[]
  timetableSlots     TimetableSlot[]
  homework           Homework[]
  studentAttendance  StudentAttendance[]
  staffAttendance    StaffAttendance[]
  leaveRequests      LeaveRequest[]
  feeParticulars     FeeParticular[]
  feeStructures      FeeStructure[]
  discountTypes      DiscountType[]
  feeInvoices        FeeInvoice[]
  feePayments        FeePayment[]
  feeReceiptReprints FeeReceiptReprint[]
  exams              Exam[]
  examPaperSlots     ExamPaperSlot[]
  questionPapers     QuestionPaperSubmission[]
  examMarks          ExamMark[]
  schoolRules        SchoolRule[]
  employeeSalaries   EmployeeSalary[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]

  // Accounting module (double-entry ledger) — see the models at the end of the file.
  accounts        Account[]
  fiscalYears     FiscalYear[]
  journalEntries  JournalEntry[]
  budgets         Budget[]
  bankAccounts    BankAccount[]
  Voucher         Voucher[]
  Invoice         Invoice[]
  BankTransaction BankTransaction[]

  // Asset & Inventory modules
  assets         Asset[]
  inventoryItems InventoryItem[]
  schoolFiles    SchoolFile[]
  notifications  Notification[]
  mailLogs       MailLog[]

  @@map("schools")
}

/// Every Cloudinary upload for a school — used to tally storage usage.
model SchoolFile {
  id           String   @id @default(cuid())
  schoolId     String
  uploadedById String?
  publicId     String
  url          String
  folder       String   @default("")
  resourceType String   @default("image")
  format       String?
  bytes        Int      @default(0)
  width        Int?
  height       Int?
  originalName String?
  purpose      String   @default("other") // logo | homework | exam-paper | employee-photo | employee-doc | student-photo | other
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, purpose])
  @@index([publicId])
  @@map("school_files")
}

/// In-app notification for a user (and optionally scoped to a school).
model Notification {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  title      String
  message    String
  /// user | fee | invoice | calendar | staff | chat | system | mail
  icon       String    @default("system")
  /// blue | green | purple | orange | red | gray
  tone       String    @default("blue")
  href       String?
  readAt     DateTime?
  /// Set once the dashboard floating toast has been shown (first time only).
  floatedAt  DateTime?
  createdAt  DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([schoolId])
  @@map("notifications")
}

/// Every outbound email — used to tally per-school mail usage.
model MailLog {
  id           String   @id @default(cuid())
  schoolId     String?
  userId       String?
  toEmail      String
  subject      String
  template     String   @default("generic")
  /// platform | school
  brand        String   @default("platform")
  status       String   @default("sent") // sent | failed | skipped
  providerId   String?
  error        String?
  meta         Json?
  createdAt    DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([toEmail])
  @@map("mail_logs")
}

/// A school administrator — the only self-registered account type.
/// Students and teachers are created later by an admin (out of scope).
model User {
  id            String    @id @default(cuid())
  schoolId      String
  branchId      String?
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("Admin")
  panel         String    @default("admin")
  emailVerified Boolean   @default(true)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([schoolId])
  @@index([branchId])
  @@map("users")
}

/// A campus/branch of a school. Every school has at least one branch created on registration.
model Branch {
  id        String       @id @default(cuid())
  schoolId  String
  name      String
  code      String // Unique per school, e.g. "MAIN", "CAMPUS-A"
  address   String?
  city      String?
  phone     String?
  status    BranchStatus @default(ACTIVE)
  isMain    Boolean      @default(false) // The primary/main branch
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assets             Asset[]
  inventoryItems     InventoryItem[]
  journalEntries     JournalEntry[]
  vouchers           Voucher[]
  budgets            Budget[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]
  accountingInvoices Invoice[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([status])
  @@map("branches")
}

/// A school's subscription. One row per billing period; the newest
/// non-expired row is the school's current entitlement.
model Subscription {
  id        String             @id @default(cuid())
  schoolId  String
  plan      SubscriptionPlan
  status    SubscriptionStatus
  startedAt DateTime
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("subscriptions")
}

/// Custom role permission configurations for a school.
model RolePermission {
  id          String   @id @default(cuid())
  schoolId    String
  role        String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, role])
  @@index([schoolId])
  @@map("role_permissions")
}

/// Support tickets and complaints for a school.
model Ticket {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  title       String
  category    String
  priority    String
  status      String   @default("Open")
  raisedBy    String
  assignedTo  String?
  due         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("tickets")
}

/// Employee record for staff (teachers, admin, non-teaching).
model Employee {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  employeeId  String
  name        String
  gender      String?  @default("Male")
  dob         String?
  cnic        String?
  phone       String?
  email       String?
  address     String?
  photo       String?
  designation String
  department  String
  joining     String
  type        String   @default("Permanent")
  status      String   @default("Active")
  documents   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("employees")
}

/// Generated employment / appointment job letters.
model JobLetter {
  id          String   @id @default(cuid())
  schoolId    String
  employeeId  String?
  employee    String
  designation String
  department  String
  date        String
  status      String   @default("Generated")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("job_letters")
}

/// School class / grade definition.
model Class {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  name        String
  code        String
  session     String?  @default("2025-2026")
  sections    Json
  teacher     String?
  /// Employee.id of the class teacher (preferred over name matching).
  teacherId   String?
  students    Int      @default(0)
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([teacherId])
  @@map("classes")
}

/// Institute course catalog. Every school manages its own list.
model Course {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  /// general | it | nursing
  category  String   @default("general")
  duration  String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([category])
  @@map("courses")
}

/// Daily student attendance — one row per student per calendar day.
model StudentAttendance {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  studentId   String
  studentName String
  studentCode String?
  cls         String
  section     String
  date        String // YYYY-MM-DD
  status      String // Present | Absent | Late | Leave
  remark      String?
  markedById  String?
  markedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, date])
  @@index([schoolId, date])
  @@index([schoolId, cls, section, date])
  @@index([schoolId, studentId])
  @@map("student_attendance")
}

/// Daily staff / employee attendance — one row per employee per calendar day.
model StaffAttendance {
  id           String   @id @default(cuid())
  schoolId     String
  branchId     String?
  employeeId   String
  employeeName String
  employeeCode String?
  designation  String?
  department   String?
  date         String // YYYY-MM-DD
  status       String // Present | Absent | Late | Leave
  inTime       String?
  outTime      String?
  remark       String?
  markedById   String?
  markedBy     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId, date])
  @@index([schoolId, date])
  @@index([schoolId, employeeId])
  @@map("staff_attendance")
}

/// Leave application from a student or teacher.
/// Student leave is visible to admin + class teacher.
/// Teacher leave is visible to admin only.
model LeaveRequest {
  id            String   @id @default(cuid())
  schoolId      String
  branchId      String?
  applicantType String // "Student" | "Teacher"
  applicantId   String
  person        String
  role          String
  cls           String?
  section       String?
  studentId     String?
  employeeId    String?
  type          String // Medical | Casual | Annual | Sick
  from          String // YYYY-MM-DD
  to            String // YYYY-MM-DD
  days          Int
  reason        String
  status        String   @default("Pending") // Pending | Approved | Rejected
  reviewedById  String?
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, applicantType])
  @@index([schoolId, studentId])
  @@index([schoolId, employeeId])
  @@index([schoolId, cls, section])
  @@map("leave_requests")
}

/// School subject catalog.
model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  name        String
  code        String
  type        String   @default("Core") // "Core" | "Elective" | "Activity"
  description String?
  status      String   @default("Active") // "Active" | "Inactive"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("subjects")
}

/// Assigned subjects to class, section and teacher.
model SubjectAssignment {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  classId     String?
  className   String
  section     String
  subjectId   String?
  subjectName String
  teacherId   String?
  teacherName String
  date        String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([className])
  @@map("subject_assignments")
}

/// Student record in the institution.
model Student {
  id            String   @id @default(cuid())
  schoolId      String
  branchId      String?
  studentId     String // e.g. STD-1001
  admissionNo   String? // e.g. ADM-2026-0001
  admissionDate String? // e.g. 2026-01-04
  name          String // Full student name
  gender        String?  @default("Male")
  dob           String?
  blood         String?
  photo         String?
  session       String?  @default("2025-2026")
  cls           String // e.g. "Grade 1"
  classId       String?
  /// Selected institute course, shown on the student list, ID card and admission letter.
  course        String?
  courseId      String?
  section       String // e.g. "A"
  father        String?
  mother        String?
  guardian      String?
  phone         String?
  email         String?
  address       String?
  prevSchool    String?
  medical       String?
  notes         String?
  /// School-specific admission extras (CNIC, programs, qualifications, fees, checklist).
  admissionExtras Json?
  /// [{ id, name, type, url, publicId?, size?, uploadDate }] — Cloudinary docs
  documents     Json     @default("[]")
  status        String   @default("Active") // "Active" | "Inactive"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([cls])
  @@index([course])
  @@index([status])
  @@map("students")
}

/// Generated student admission letters.
model AdmissionLetter {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  studentId   String?
  student     String
  admissionNo String
  cls         String
  course      String?
  section     String
  date        String
  status      String   @default("Generated") // "Generated" | "Pending" | "Printed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("admission_letters")
}

/// A family groups one or more students under a single guardian.
model Family {
  id         String   @id @default(cuid())
  schoolId   String
  branchId   String?
  familyCode String // e.g. FAM-001
  guardian   String
  phone      String?
  email      String?
  address    String?
  notes      String?
  status     String   @default("Active") // "Active" | "Inactive"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("families")
}

/// Admission pipeline tracking.
model AdmissionEnquiry {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  applicant String
  guardian  String?
  phone     String?
  cls       String?
  source    String?
  followUp  String?
  counselor String?
  stage     String   @default("Enquiry") // "Enquiry" | "Follow-up" | "Application" | "Test" | "Approved" | "Admitted" | "Rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([stage])
  @@map("admission_enquiries")
}

/// Front office visitors log.
model Visitor {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  visitor   String
  phone     String?
  purpose   String?
  host      String?
  badge     String?
  date      String?
  inTime    String?
  outTime   String?
  status    String   @default("In") // "In" | "Out"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("visitors")
}

/// Communication notices.
model Notice {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  title     String
  content   String?
  audience  String?
  channel   String?
  type      String?
  date      String?
  reach     Int      @default(0)
  status    String   @default("Draft")
  author    String?
  authorId  String?
  cls       String?
  section   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("notices")
}

/// School events.
model Event {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  title     String
  type      String?
  startDate String?
  endDate   String?
  venue     String?
  audience  String?
  status    String   @default("Upcoming")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("events")
}

/// Meetings.
model Meeting {
  id           String   @id @default(cuid())
  schoolId     String
  branchId     String?
  title        String
  date         String?
  time         String?
  venue        String?
  organizer    String?
  status       String   @default("Scheduled")
  description  String?
  participants String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("meetings")
}

/// Transport Fleet Vehicles.
model Vehicle {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  number      String
  type        String   @default("Bus")
  capacity    Int      @default(30)
  driver      String
  driverPhone String?
  route       String?
  fitness     String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("vehicles")
}

/// Transport Routes.
model TransportRoute {
  id         String   @id @default(cuid())
  schoolId   String
  branchId   String?
  name       String
  stops      Int      @default(1)
  distance   String?
  students   Int      @default(0)
  monthlyFee Float    @default(0)
  vehicleId  String? // assigned fleet vehicle id
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("transport_routes")
}

/// Hostel Rooms & Occupancy.
model HostelRoom {
  id         String   @id @default(cuid())
  schoolId   String
  branchId   String?
  hostel     String
  room       String
  type       String   @default("Double")
  beds       Int      @default(2)
  occupied   Int      @default(0)
  warden     String?
  monthlyFee Float    @default(0)
  status     String   @default("Available")
  residents  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("hostel_rooms")
}

/// School Timetable Periods/Slots.
model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  cls       String
  section   String
  day       String
  period    Int
  startTime String?
  endTime   String?
  subject   String
  teacher   String
  teacherId String?
  room      String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, teacher])
  @@index([schoolId, cls, section])
  @@map("timetable_slots")
}

/// Homework / Assignments created by teachers.
model Homework {
  id           String   @id @default(cuid())
  schoolId     String
  branchId     String?
  title        String
  subject      String
  cls          String // e.g. "Grade 10"
  section      String // e.g. "A"
  teacher      String
  teacherId    String?
  assigned     String // ISO date "2026-10-07"
  due          String // ISO date "2026-10-14"
  instructions String?
  status       String   @default("Open") // "Open" | "Due Soon" | "Grading" | "Closed"
  submitted    Int      @default(0)
  total        Int      @default(0)
  attachments  Json     @default("[]") // Array of { name, url, size, type }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, teacher])
  @@index([schoolId, cls, section])
  @@map("homework")
}

/// Exam session announced by admin (Monthly / Mid-Term / Final / Quiz…).
model Exam {
  id              String   @id @default(cuid())
  schoolId        String
  branchId        String?
  name            String
  type            String // "Monthly" | "Mid-Term" | "Final" | "Quiz" | "Other"
  session         String
  startDate       String // exam window start YYYY-MM-DD
  endDate         String // exam window end
  paperSubmitFrom String? // teachers must submit question papers from
  paperSubmitTo   String? // …until this date
  classes         Json     @default("[]") // class names covered, e.g. ["Grade 9","Grade 10"]
  classesCount    Int      @default(0)
  status             String   @default("Draft") // Draft | Notified | Scheduled | Marks Entry | Verification | Published
  notifyNote         String?
  notifiedAt         String? // ISO date when teachers were notified
  resultAnnounceDate String? // planned / actual result announcement date YYYY-MM-DD
  publishedAt        String? // when results were published YYYY-MM-DD
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots         ExamPaperSlot[]
  submissions   QuestionPaperSubmission[]
  marks         ExamMark[]

  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, status])
  @@map("exams")
}

/// Subject-wise marks entered by teacher / admin for an exam.
model ExamMark {
  id           String   @id @default(cuid())
  schoolId     String
  examId       String
  slotId       String?
  branchId     String?
  studentId    String
  studentName  String
  studentCode  String?
  cls          String
  section      String   @default("")
  subject      String
  obtained     Int      @default(0)
  total        Int      @default(100)
  grade        String?
  remark       String?
  enteredById  String?
  enteredBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([schoolId, examId, studentId, subject, cls, section])
  @@index([schoolId, examId])
  @@index([schoolId, studentId])
  @@index([schoolId, examId, cls, section, subject])
  @@map("exam_marks")
}

/// Class-wise paper timetable slot for an exam.
model ExamPaperSlot {
  id            String   @id @default(cuid())
  schoolId      String
  examId        String
  branchId      String?
  cls           String
  section       String   @default("") // empty = whole class / all sections
  subject       String
  subjectId     String?
  date          String // YYYY-MM-DD
  startTime     String
  endTime       String
  room          String?
  invigilator   String?
  teacherId     String? // expected paper setter (employee id)
  teacherName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam        Exam                       @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions QuestionPaperSubmission[]

  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, teacherId])
  @@index([schoolId, cls, subject])
  @@map("exam_paper_slots")
}

/// Teacher-submitted question paper (file/image) for a slot or class+subject.
model QuestionPaperSubmission {
  id            String   @id @default(cuid())
  schoolId      String
  examId        String
  slotId        String?
  branchId      String?
  cls           String
  section       String   @default("")
  subject       String
  teacherId     String?
  teacherName   String
  employeeId    String?
  status        String   @default("Submitted") // Pending | Submitted | Approved | Rejected
  note          String?
  files         Json     @default("[]") // [{ name, type, size, url, publicId? }]
  submittedAt   String?
  reviewedAt    String?
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam   Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  slot   ExamPaperSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, teacherId])
  @@index([schoolId, slotId])
  @@map("question_paper_submissions")
}

// ==========================================================================
// ACCOUNTING MODULE — double-entry ledger.
// --------------------------------------------------------------------------
// Money is stored as integer rupees (Int) — no floating point drift. Label
// style fields (account `type`, journal/voucher `status`, voucher `kind`,
// voucher `method`, bank `kind`) are stored as their display strings so the UI
// can round-trip them verbatim; the allowed values are enforced in the
// service + validator layer. Every row is scoped by `schoolId` for tenant
// isolation. Posted journal lines are the single source of truth for all
// derived balances and financial reports.
// ==========================================================================

/// A ledger account in the Chart of Accounts (assets, liabilities, equity,
/// income, expenses). `code` is unique per school.
model Account {
  id             String   @id @default(cuid())
  schoolId       String
  code           String
  name           String
  type           String // "Asset" | "Liability" | "Equity" | "Income" | "Expense"
  parent         String   @default("")
  isActive       Boolean  @default(true)
  isSystem       Boolean  @default(false)
  openingBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalLines JournalLine[]
  vouchers     Voucher[]
  invoices     Invoice[]
  bankAccounts BankAccount[]
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, type])
  @@map("accounts")
}

/// A fiscal year containing accounting periods. A period can be locked to stop
/// postings inside it.
model FiscalYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods AccountingPeriod[]
  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fiscal_years")
}

/// A sub-period of a fiscal year (month/quarter). When `isLocked` is true, no
/// new journal entries may be posted inside its date range.
model AccountingPeriod {
  id           String   @id @default(cuid())
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([fiscalYearId])
  @@map("accounting_period")
}

/// A journal entry header. Its `lines` must balance (sum of debits == sum of
/// credits) before it can be posted. Draft entries never affect balances.
model JournalEntry {
  id             String    @id @default(cuid())
  schoolId       String
  branchId       String?
  no             String
  date           DateTime
  description    String
  reference      String    @default("")
  status         String    @default("Draft") // "Draft" | "Posted" | "Cancelled"
  notes          String    @default("")
  createdById    String?
  createdByName  String    @default("")
  postedAt       DateTime?
  reversedFromId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines            JournalLine[]
  vouchers         Voucher[]
  bankTransactions BankTransaction[]
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, no])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, status])
  @@index([schoolId, date])
  @@map("journal_entries")
}

/// A single debit/credit line of a journal entry. Exactly one of debit/credit
/// is non-zero. Posted lines drive every derived balance and financial report.
model JournalLine {
  id          String @id @default(cuid())
  entryId     String
  accountId   String
  description String @default("")
  debit       Int    @default(0)
  credit      Int    @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// A receipt or payment voucher. Creating + posting a voucher also creates and
/// posts a balanced journal entry (`journalEntryId`) so the ledger stays
/// consistent. `kind` is "Receipt" or "Payment".
model Voucher {
  id             String   @id @default(cuid())
  schoolId       String
  branchId       String?
  no             String
  kind           String // "Receipt" | "Payment"
  date           DateTime
  party          String
  accountId      String
  amount         Int
  method         String   @default("Cash") // "Cash" | "Bank" | "Cheque" | "Online"
  /// Ledger Account id used for the Cash/Bank contra leg (so UI can show which bank/cash was used).
  cashBankAccountId String?
  reference      String   @default("")
  status         String   @default("Draft") // "Draft" | "Posted" | "Cancelled"
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      Account       @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, no])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, kind])
  @@index([schoolId, status])
  @@map("vouchers")
}

/// Catalog of fee heads (Tuition, Transport, Exam, …).
model FeeParticular {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  particular  String
  description String?
  amount      Int      @default(0)
  frequency   String   @default("Monthly") // Monthly | Quarterly | Annually | One-time
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("fee_particulars")
}

/// Fee lines configured per session / class / section.
model FeeStructure {
  id           String   @id @default(cuid())
  schoolId     String
  branchId     String?
  session      String
  cls          String
  section      String
  particularId String?
  particular   String
  amount       Int      @default(0)
  frequency    String   @default("Monthly")
  dueDate      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, session, cls, section])
  @@map("fee_structures")
}

/// Named discount rules (sibling, scholarship, …).
model DiscountType {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  name        String
  basis       String // Percentage | Fixed Amount
  value       Int      @default(0)
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, status])
  @@map("discount_types")
}

/// School fee invoice (separate from accounting AR Invoice).
model FeeInvoice {
  id             String   @id @default(cuid())
  schoolId       String
  branchId       String?
  invoiceNo      String
  studentId      String?
  student        String
  studentCode    String?
  cls            String
  section        String
  /// Academic session captured at invoice creation (e.g. 2025-2026).
  session        String?
  period         String
  issue          String
  due            String
  total          Int      @default(0)
  discount       Int      @default(0)
  paid           Int      @default(0)
  balance        Int      @default(0)
  status         String   @default("Pending") // Paid | Partially Paid | Pending | Overdue
  discountTypeId String?
  discountName   String?
  lines          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments FeePayment[]

  @@unique([schoolId, invoiceNo])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@map("fee_invoices")
}

/// Immutable recorded fee payment + receipt snapshot (one row per successful collection).
model FeePayment {
  id               String   @id @default(cuid())
  schoolId         String
  branchId         String?
  receiptNo        String
  invoiceId        String
  invoiceNo        String
  studentId        String?
  studentName      String
  studentCode      String?
  admissionNo      String?
  cls              String
  section          String
  session          String?
  period           String
  amount           Int
  method           String   @default("Cash")
  reference        String   @default("")
  /// Selected cash/bank account (BankAccount.id preferred; may be ledger Account.id).
  cashBankAccountId     String?
  cashBankAccountName   String  @default("")
  cashBankAccountNumber String  @default("")
  cashierId        String?
  cashierName      String   @default("")
  paidAt           DateTime @default(now())
  /// Invoice total (gross) at payment time.
  grossAmount      Int      @default(0)
  discount         Int      @default(0)
  /// Outstanding balance before this payment.
  previousBalance  Int      @default(0)
  /// Outstanding balance after this payment.
  remainingBalance Int      @default(0)
  /// Receipt payment status label: PAID | PARTIAL PAYMENT
  status           String
  linesSnapshot    Json?
  schoolSnapshot   Json?
  voucherId        String?
  voucherNo        String?
  journalEntryId   String?
  /// Client-supplied key to make retries idempotent (unique per school when set).
  idempotencyKey   String?
  reprintCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice  FeeInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reprints FeeReceiptReprint[]

  @@unique([schoolId, receiptNo])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([schoolId, invoiceId])
  @@index([schoolId, studentId])
  @@index([schoolId, paidAt])
  @@index([schoolId, receiptNo])
  @@map("fee_payments")
}

/// Audit log for receipt reprints / duplicate copies (does not create payments).
model FeeReceiptReprint {
  id         String   @id @default(cuid())
  schoolId   String
  paymentId  String
  receiptNo  String
  userId     String?
  userName   String   @default("")
  createdAt  DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, paymentId])
  @@index([schoolId, createdAt])
  @@map("fee_receipt_reprints")
}

/// A student fee invoice (accounts receivable). `paid` is kept in sync with the
/// money actually received; `status` is derived from paid vs total and due date.
model Invoice {
  id          String   @id @default(cuid())
  schoolId    String
  branchId    String?
  studentName String
  studentCode String
  className   String
  section     String
  invoiceNo   String
  dueDate     DateTime
  total       Int
  paid        Int      @default(0)
  status      String   @default("Pending") // "Paid" | "Partial" | "Pending" | "Overdue"
  accountId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id])
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, invoiceNo])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, status])
  @@map("invoices")
}

/// A department budget for a fiscal year. `spent` can be recomputed from actual
/// expense postings; `remaining` is derived (amount - spent).
model Budget {
  id         String   @id @default(cuid())
  schoolId   String
  branchId   String?
  name       String
  department String
  year       String
  amount     Int
  spent      Int      @default(0)
  status     String   @default("Active") // "Active" | "Inactive" | "Completed" | "Over Budget"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, name, year])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@map("budgets")
}

/// A cash or bank account, backed by a ledger `Account`. Balances are derived
/// from posted journal lines; this row holds the metadata (name, number, kind).
model BankAccount {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  name      String
  number    String   @default("")
  kind      String   @default("Bank") // "Cash" | "Bank"
  isActive  Boolean  @default(true)
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      Account           @relation(fields: [accountId], references: [id])
  transactions BankTransaction[]
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@map("bank_accounts")
}

/// Per-employee salary structure used when generating monthly payroll.
model EmployeeSalary {
  id             String   @id @default(cuid())
  schoolId       String
  branchId       String?
  employeeId     String
  employeeName   String
  employeeCode   String   @default("")
  designation    String   @default("")
  department     String   @default("")
  basic          Int      @default(0)
  houseRent      Int      @default(0)
  transport      Int      @default(0)
  medical        Int      @default(0)
  otherAllow     Int      @default(0)
  tax            Int      @default(0)
  providentFund  Int      @default(0)
  otherDeduct    Int      @default(0)
  effectiveFrom  String?
  status         String   @default("Active") // Active | Inactive
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("employee_salaries")
}

/// Monthly payroll cycle for a campus (Draft → Approved → Paid).
model PayrollRun {
  id              String    @id @default(cuid())
  schoolId        String
  branchId        String?
  month           String // YYYY-MM
  title           String?
  status          String    @default("Draft") // Draft | Approved | Paid
  totalGross      Int       @default(0)
  totalDeductions Int       @default(0)
  totalNet        Int       @default(0)
  employeeCount   Int       @default(0)
  notes           String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([schoolId])
  @@index([schoolId, month])
  @@index([schoolId, status])
  @@map("payroll_runs")
}

/// One employee payslip inside a payroll run.
model Payslip {
  id            String    @id @default(cuid())
  schoolId      String
  branchId      String?
  payrollRunId  String
  employeeId    String
  employeeName  String
  employeeCode  String    @default("")
  designation   String    @default("")
  department    String    @default("")
  month         String // YYYY-MM
  basic         Int       @default(0)
  houseRent     Int       @default(0)
  transport     Int       @default(0)
  medical       Int       @default(0)
  otherAllow    Int       @default(0)
  allowances    Int       @default(0)
  tax           Int       @default(0)
  providentFund Int       @default(0)
  otherDeduct   Int       @default(0)
  deductions    Int       @default(0)
  gross         Int       @default(0)
  net           Int       @default(0)
  status        String    @default("Draft") // Draft | Approved | Paid
  note          String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([schoolId])
  @@index([schoolId, employeeId])
  @@index([schoolId, month])
  @@map("payslips")
}

/// School rules & regulations published by admin for teachers and/or students.
model SchoolRule {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  title     String
  body      String
  /// Who should see this rule: "Teachers" | "Students" | "Both"
  audience  String   @default("Both")
  status    String   @default("Active") // "Active" | "Inactive"
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, audience])
  @@index([schoolId, status])
  @@map("school_rules")
}

/// A bank reconciliation line — the book amount (from the ledger) matched
/// against the bank statement amount. `status` is "Matched" | "Unmatched".
model BankTransaction {
  id             String   @id @default(cuid())
  schoolId       String
  branchId       String?
  bankAccountId  String
  date           DateTime
  reference      String   @default("")
  description    String   @default("")
  bookAmount     Int      @default(0)
  bankAmount     Int      @default(0)
  status         String   @default("Unmatched") // "Matched" | "Unmatched"
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@map("bank_transactions")
}

/// Capital and physical assets register
model Asset {
  id           String   @id @default(cuid())
  schoolId     String
  branchId     String?
  name         String
  category     String
  tag          String
  purchaseDate String?
  cost         Int      @default(0)
  location     String   @default("")
  assignee     String   @default("")
  warranty     String   @default("")
  status       String   @default("In Use") // "In Use" | "In Store" | "Repair" | "Disposed"
  notes        String?  @default("")
  /// Linked payment voucher when purchase was posted to accounting
  voucherId    String?
  voucherNo    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([schoolId, tag])
  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, status])
  @@map("assets")
}

/// Inventory items, consumables and stock levels
model InventoryItem {
  id        String   @id @default(cuid())
  schoolId  String
  branchId  String?
  item      String
  category  String
  qty       Int      @default(0)
  unit      String   @default("pc")
  reorder   Int      @default(0)
  supplier  String   @default("")
  value     Int      @default(0)
  status    String   @default("In Stock") // "In Stock" | "Low Stock" | "Out of Stock"
  /// Last payment voucher when stock purchase was posted to accounting
  voucherId String?
  voucherNo String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, branchId])
  @@index([schoolId, status])
  @@map("inventory_items")
}

/// Connected Google account used to create Meet spaces (per teacher or school admin).
model GoogleIntegration {
  id                   String    @id @default(cuid())
  schoolId             String
  /// User who connected Google (teacher or admin).
  userId               String
  googleEmail          String
  googleAccountId      String?
  encryptedAccessToken String
  encryptedRefreshToken String
  tokenExpiry          DateTime?
  scopes               String    @default("")
  connectionStatus     String    @default("Connected") // Connected | Expired | Revoked | Error
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("google_integrations")
}

/// Scheduled Google Meet online class tied to academic class/section/subject.
model OnlineClass {
  id                   String   @id @default(cuid())
  schoolId             String
  branchId             String?
  teacherUserId        String
  teacherName          String   @default("")
  teacherEmployeeId    String?
  cls                  String
  section              String
  subjectId            String?
  subjectName          String   @default("")
  title                String
  description          String   @default("")
  /// ISO datetime in UTC.
  scheduledAt          DateTime
  durationMinutes      Int      @default(45)
  timezone             String   @default("Asia/Karachi")
  /// Google Meet space resource name, e.g. spaces/xxx
  meetingSpaceName     String?
  meetingUrl           String?
  meetingCode          String?
  conferenceRecordName String?
  status               String   @default("Scheduled") // Scheduled | Live | Completed | Cancelled
  /// JSON array of student ids; empty = all students in class+section.
  studentIds           Json?
  cancelReason         String?
  googleIntegrationId  String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  school       School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants OnlineClassParticipant[]
  syncLogs     OnlineClassAttendanceSync[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, teacherUserId])
  @@index([schoolId, scheduledAt])
  @@index([schoolId, cls, section])
  @@map("online_classes")
}

model OnlineClassParticipant {
  id                         String    @id @default(cuid())
  schoolId                   String
  onlineClassId              String
  studentId                  String?
  studentName                String    @default("")
  studentCode                String?
  googleParticipantName      String?
  googleParticipantIdentifier String?
  googleDisplayName          String?
  joinTime                   DateTime?
  leaveTime                  DateTime?
  attendedMinutes            Int       @default(0)
  /// Present | Late | Absent | Partial | Pending Verification | Joined
  attendanceStatus           String    @default("Pending Verification")
  joinAttempts               Int       @default(0)
  lastJoinAt                 DateTime?
  manuallyVerified           Boolean   @default(false)
  matchedBy                  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  onlineClass OnlineClass @relation(fields: [onlineClassId], references: [id], onDelete: Cascade)

  @@unique([onlineClassId, studentId])
  @@index([schoolId])
  @@index([onlineClassId])
  @@index([studentId])
  @@map("online_class_participants")
}

model OnlineClassAttendanceSync {
  id               String   @id @default(cuid())
  schoolId         String
  onlineClassId    String
  syncStatus       String   @default("Pending") // Pending | Running | Success | Partial | Failed
  lastSyncedAt     DateTime?
  recordsProcessed Int      @default(0)
  errorMessage     String?
  details          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  onlineClass OnlineClass @relation(fields: [onlineClassId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([onlineClassId])
  @@map("online_class_attendance_syncs")
}

